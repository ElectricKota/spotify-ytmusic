# Spotify aplikace z https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Musí přesně odpovídat Redirect URI nastavenému v aplikaci (Spotify nepovoluje "localhost", jen 127.0.0.1)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Soubor s hlavičkami z prohlížeče, vytvoří ho `uv run ytmusicapi browser`
YTM_AUTH_FILE=browser.json

# Lokální databáze se stavem přenosu
DB_PATH=state.db
